---
import Layout from "../layouts/Layout.astro";
import { eveJson } from "../lib/eve";

let status: unknown;
let error = "";
try {
	status = await eveJson("/eve/v1/health");
} catch (cause) {
	error = cause instanceof Error ? cause.message : String(cause);
}
---
<Layout title="Wind Tunnel Status">
  <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-start">
    <div><div class="font-mono text-xs uppercase tracking-wider text-slate-500">Nazare Wind Tunnel · eve</div><h1 class="mt-1 text-2xl font-bold">System status</h1></div>
    <a class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 hover:border-slate-500" href="/">← Sessions</a>
  </div>
  {error?<pre class="whitespace-pre-wrap rounded-xl border border-red-900 bg-red-950/30 p-4 font-mono text-xs text-red-300">{error}</pre>:<pre class="overflow-auto whitespace-pre-wrap rounded-xl border border-slate-800 bg-slate-900 p-4 font-mono text-xs text-slate-300">{JSON.stringify(status,null,2)}</pre>}
</Layout>
