---
import Layout from "../../layouts/Layout.astro";

const id = Astro.params.id ?? "";
---
<Layout title={`eve session ${id.slice(0,12)}`}>
  <div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-start">
    <div><div class="font-mono text-xs uppercase tracking-wider text-slate-500">Nazare Wind Tunnel · eve</div><h1 class="mt-1 text-2xl font-bold">Session <span class="font-mono text-base text-slate-400">{id}</span></h1></div>
    <a class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 hover:border-slate-500" href="/">← Sessions</a>
  </div>
  <div id="app" class="grid gap-3"><div class="rounded-xl border border-slate-800 bg-slate-900 p-4 text-slate-400">Loading durable event stream…</div></div>
  <script define:vars={{id}}>
    const escapeHtml=(value)=>String(value??'').replace(/[&<>\"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[char]));
    const eventsByType=(events,type)=>events.filter(event=>event.type===type);
    const eventAt=(event)=>Date.parse(event?.meta?.at??0);
    const formatDuration=(milliseconds)=>milliseconds<1000?`${Math.round(milliseconds)} ms`:`${(milliseconds/1000).toFixed(milliseconds<10000?1:0)} s`;
    const compact=(value,limit=5000)=>{const text=typeof value==='string'?value:JSON.stringify(value,null,2);return text.length>limit?text.slice(0,limit)+'\n[truncated]':text;};
    const remember=()=>{const key='nazare-eve-sessions';let sessions=[];try{sessions=JSON.parse(localStorage.getItem(key)||'[]')}catch{};sessions=[{id,at:new Date().toISOString()},...sessions.filter(item=>item.id!==id)].slice(0,30);localStorage.setItem(key,JSON.stringify(sessions));};
    function derive(events){
      const started=events.find(event=>event.type==='session.started');const latest=events.at(-1);const failed=events.find(event=>event.type==='turn.failed'||event.type==='session.failed');const waiting=events.find(event=>event.type==='session.waiting');
      const finish=eventsByType(events,'action.result').map(event=>event.data?.result).find(result=>result?.toolName==='finish_run'&&!result?.isError)?.output;
      const status=failed||finish?.passed===false?'failed':waiting?'completed':latest?.type==='session.completed'?'completed':'running';
      return {started,latest,failed,finish,status,elapsed:started&&latest?Math.max(0,eventAt(latest)-eventAt(started)):0,model:events.find(event=>event.type==='step.started')?.data?.modelId??'—',tools:eventsByType(events,'action.result')};
    }
    function conversation(events){
      const items=[];
      for(const event of events){
        if(event.type==='message.received')items.push({role:'user',at:event.meta?.at,text:event.data?.message});
        if(event.type==='reasoning.completed')items.push({role:'reasoning',at:event.meta?.at,text:event.data?.reasoning});
        if(event.type==='action.result'){
          const result=event.data?.result;items.push({role:'tool',at:event.meta?.at,text:`${result?.toolName??'tool'}${result?.isError?' · failed':''}\n${compact(result?.output??'',2500)}`});
        }
        if(event.type==='message.completed')items.push({role:'assistant',at:event.meta?.at,text:event.data?.message});
      }
      return items;
    }
    function render(events){
      const state=derive(events);const result=state.finish;const timings=result?.timings;const changed=Array.isArray(result?.changedFiles)?result.changedFiles:[];const checks=Array.isArray(result?.checks)?result.checks:[];
      const messages=conversation(events).map(item=>`<article class="rounded-lg border ${item.role==='assistant'?'border-emerald-900':item.role==='tool'?'border-amber-900':item.role==='reasoning'?'border-slate-800 border-dashed':'border-blue-900'} bg-slate-950 p-3"><div class="mb-2 flex justify-between gap-3 font-mono text-xs uppercase tracking-wide text-slate-500"><span>${escapeHtml(item.role)}</span><span>${item.at?new Date(item.at).toLocaleTimeString():'—'}</span></div><pre class="overflow-x-auto whitespace-pre-wrap font-mono text-xs leading-5 text-slate-300">${escapeHtml(item.text)}</pre></article>`).join('');
      const checkRows=checks.map(check=>`<div class="flex justify-between gap-3 border-b border-slate-800 py-2 text-sm"><span>${escapeHtml(check.name)}</span><strong class="${check.passed?'text-emerald-400':'text-red-400'}">${check.passed?'pass':'fail'}</strong></div>`).join('')||'<div class="text-sm text-slate-500">No finish evidence yet.</div>';
      document.querySelector('#app').innerHTML=`<section class="rounded-xl border border-slate-800 bg-slate-900 p-4"><div class="flex justify-between gap-4"><span class="font-mono text-xs font-bold uppercase ${state.status==='failed'?'text-red-400':state.status==='completed'?'text-emerald-400':'text-blue-400'}">${state.status}</span><strong>${formatDuration(state.elapsed)}</strong></div>${state.failed?`<pre class="mt-4 whitespace-pre-wrap rounded-lg bg-red-950/40 p-3 font-mono text-xs text-red-300">${escapeHtml(compact(state.failed.data))}</pre>`:''}</section><div class="grid gap-3 md:grid-cols-2"><section class="rounded-xl border border-slate-800 bg-slate-900 p-4"><h2 class="mb-3 font-semibold">Execution</h2><div class="grid grid-cols-[8rem_1fr] gap-2 text-sm"><span class="text-slate-500">runtime</span><span>eve 0.52.5</span><span class="text-slate-500">workflow</span><span>Vercel Workflow</span><span class="text-slate-500">sandbox</span><span>Vercel Sandbox</span><span class="text-slate-500">model</span><span>${escapeHtml(state.model)}</span><span class="text-slate-500">tool calls</span><span>${state.tools.length}</span><span class="text-slate-500">preparation</span><span>${timings?formatDuration(timings.preparationDurationMs):'—'}</span><span class="text-slate-500">model phase</span><span>${timings?`${formatDuration(timings.modelPhaseDurationMs)} / ${formatDuration(timings.modelPhaseBudgetMs)}`:'—'}</span><span class="text-slate-500">changed files</span><span>${changed.length}</span></div>${state.status==='running'?'<button id="cancel" class="mt-4 rounded-lg border border-red-900 px-3 py-2 text-sm text-red-300">Cancel run</button>':''}</section><section class="rounded-xl border border-slate-800 bg-slate-900 p-4"><h2 class="mb-3 font-semibold">Verification</h2>${checkRows}</section></div><section class="rounded-xl border border-slate-800 bg-slate-900 p-4"><h2 class="mb-3 font-semibold">Changed files</h2>${changed.length?`<pre class="overflow-auto rounded-lg bg-slate-950 p-3 font-mono text-xs text-slate-300">${escapeHtml(changed.join('\n'))}</pre>`:'<div class="text-sm text-slate-500">No changes captured.</div>'}</section><section class="rounded-xl border border-slate-800 bg-slate-900 p-4"><h2 class="mb-3 font-semibold">Agent activity</h2><div class="grid max-h-[44rem] gap-2 overflow-auto">${messages||'<div class="text-sm text-slate-500">Waiting for activity…</div>'}</div></section><details class="rounded-xl border border-slate-800 bg-slate-900 p-4"><summary class="cursor-pointer font-semibold">Raw eve events (${events.length})</summary><pre class="mt-3 max-h-[32rem] overflow-auto whitespace-pre-wrap rounded-lg bg-slate-950 p-3 font-mono text-xs text-slate-400">${escapeHtml(events.map(event=>`${event.meta?.at??''}  ${event.type}  ${compact(event.data??{},800)}`).join('\n'))}</pre></details>`;
      document.querySelector('#cancel')?.addEventListener('click',async()=>{if(confirm('Cancel active eve turn?'))await fetch(`/api/sessions/${encodeURIComponent(id)}`,{method:'DELETE'});});
      return state.status;
    }
    async function refresh(){const response=await fetch(`/api/sessions/${encodeURIComponent(id)}`);if(!response.ok){document.querySelector('#app').innerHTML=`<div class="rounded-xl border border-red-900 bg-red-950/30 p-4 text-red-300">${escapeHtml(await response.text())}</div>`;return 'failed';}const payload=await response.json();return render(payload.events??[]);}
    remember();
    let status=await refresh();
    const timer=setInterval(async()=>{if(document.visibilityState==='visible')status=await refresh();if(status!=='running')clearInterval(timer);},2000);
  </script>
</Layout>
