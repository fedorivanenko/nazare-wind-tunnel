---
import "../styles/global.css";
const { title = "Nazare Wind Tunnel" } = Astro.props;
---
<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#0d0f14] text-slate-100 antialiased">
    <main class="mx-auto max-w-6xl p-5 md:p-8"><slot /></main>
  </body>
</html>
