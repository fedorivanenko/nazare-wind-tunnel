---
const {title = 'Nazare Wind Tunnel'} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <style is:global>
    :root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:#0d0f14;color:#eef0f5}*{box-sizing:border-box}body{margin:0;background:#0d0f14;color:#eef0f5}a{color:inherit;text-decoration:none}button,input{font:inherit}main{max-width:1180px;margin:0 auto;padding:28px}.header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px}.eyebrow{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;color:#81899c;text-transform:uppercase;letter-spacing:.08em}h1{font-size:26px;margin:4px 0 0}h2{font-size:16px;margin:0 0 12px}.card{background:#141821;border:1px solid #282e3a;border-radius:12px;padding:16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.runs{display:grid;gap:9px}.run{display:block;background:#141821;border:1px solid #282e3a;border-radius:10px;padding:13px}.run:hover{border-color:#475269}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.meta,.muted{color:#8c95a8}.meta{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;margin-top:7px;overflow-wrap:anywhere}.status{font:700 12px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.status.running,.status.preparing,.status.compiling,.status.verifying{color:#71a8ff}.status.completed{color:#70d89c}.status.failed{color:#ff7777}.status.cancelled,.status.cancelling{color:#e6bc62}.kv{display:grid;grid-template-columns:150px 1fr;gap:8px 14px;font-size:13px}.progress{height:8px;background:#252b36;border-radius:999px;overflow:hidden}.progress>span{display:block;height:100%;background:#71a8ff}.timeline{max-height:520px;overflow:auto;background:#0a0c11;border-radius:8px;padding:12px;font:12px ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap}.error{color:#ff9292;white-space:pre-wrap;font:12px ui-monospace,SFMono-Regular,Menlo,monospace}.artifact{padding:8px 0;border-bottom:1px solid #272d38;font:12px ui-monospace,SFMono-Regular,Menlo,monospace}.phase{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #272d38}.button{border:1px solid #3a4355;background:#1a1f2a;color:#eef0f5;border-radius:8px;padding:9px 12px;cursor:pointer}.button.danger{border-color:#713943;color:#ff9ca6}.pill{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;padding:3px 7px;border:1px solid #313949;border-radius:999px}.healthy{color:#70d89c}.stale{color:#ff7777}.empty{border:1px dashed #303746;border-radius:10px;padding:18px;color:#8c95a8}.login{max-width:420px;margin:16vh auto}.login input{width:100%;margin:12px 0;padding:11px;border-radius:8px;border:1px solid #303746;background:#11151d;color:#fff}.stack{display:grid;gap:12px}@media(max-width:800px){main{padding:18px}.grid{grid-template-columns:1fr}.header{flex-direction:column}.kv{grid-template-columns:110px 1fr}}
  </style>
</head>
<body><main><slot /></main></body>
</html>
