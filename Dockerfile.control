FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --include=dev \
  && npx --yes @earendil-works/pi-coding-agent@0.85.1 --version >/dev/null

COPY . .

ENV WIND_TUNNEL_WORKSPACE=/workspace
VOLUME ["/workspace"]

CMD ["npm", "start"]
