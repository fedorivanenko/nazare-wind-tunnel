FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --include=dev --ignore-scripts \
  && ./node_modules/.bin/pi --version >/dev/null

COPY . .

ENV WIND_TUNNEL_WORKSPACE=/workspace
ENV WIND_TUNNEL_PI_BIN=/app/node_modules/.bin/pi

CMD ["npm", "start"]
