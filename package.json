{
  "name": "nazare-wind-tunnel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "start": "eve start",
    "build": "eve build",
    "dev": "eve dev",
    "deploy": "eve deploy",
    "dashboard:dev": "pnpm --filter @nazare/wind-tunnel-dashboard dev",
    "dashboard:build": "pnpm --filter @nazare/wind-tunnel-dashboard build",
    "typecheck": "tsc -p tsconfig.eve.json --noEmit",
    "check": "biome check agent scripts apps/dashboard/src apps/dashboard/astro.config.mjs"
  },
  "dependencies": {
    "ai": "^7.0.97",
    "eve": "0.52.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
