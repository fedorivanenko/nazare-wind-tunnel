{
  "name": "nazare-wind-tunnel",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "start": "eve start",
    "build": "eve build",
    "dev": "eve dev",
    "deploy": "eve deploy",
    "api": "pnpm --filter @nazare/wind-tunnel-api start",
    "worker": "pnpm --filter @nazare/wind-tunnel-worker start",
    "dashboard": "pnpm --filter @nazare/wind-tunnel-dashboard start",
    "dashboard:build": "pnpm --filter @nazare/wind-tunnel-dashboard build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.eve.json --noEmit",
    "test": "pnpm --filter @nazare/wind-tunnel-domain test && pnpm --filter @nazare/wind-tunnel-pi test && pnpm --filter @nazare/wind-tunnel-subject-manager test",
    "ci": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "ai": "^7.0.97",
    "eve": "0.52.5",
    "zod": "^4.6.1"
  }
}
