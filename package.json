{
  "name": "nazare-wind-tunnel",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "start": "pnpm --filter @nazare/wind-tunnel-api start",
