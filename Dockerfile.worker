FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git postgresql-client \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.17.1 --activate

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @nazare/wind-tunnel-pi exec pi --version >/dev/null

ENV NODE_ENV=production
ENV WIND_TUNNEL_WORKSPACE=/workspace
ENV WIND_TUNNEL_PNPM_STORE=/workspace/pnpm-store
ENV WIND_TUNNEL_PI_BIN=/app/packages/pi/node_modules/.bin/pi
CMD ["pnpm", "worker"]
